# ---------------------------------------------------------------
#  Multi-AI Agent Council - API keys
#  1) Rename this file to  .env   (remove ".example")
#  2) Replace each "your_..." placeholder with your real key
#  3) Keep the file private. Never share it or upload it anywhere.
#  You can also enter keys in the dashboard: Settings -> API keys.
# ---------------------------------------------------------------

# OPTION A - one OpenRouter key per agent (https://openrouter.ai/keys). Only models ending in ":free" are used.
OPENROUTER_API_KEY_RESEARCHER=your_openrouter_key_for_researcher
OPENROUTER_API_KEY_TECHNICAL=your_openrouter_key_for_technical_expert
OPENROUTER_API_KEY_CRITIC=your_openrouter_key_for_critic
OPENROUTER_API_KEY_INNOVATOR=your_openrouter_key_for_innovator
OPENROUTER_API_KEY_JUDGE=your_openrouter_key_for_judge

# OPTION B - one shared OpenRouter key, used by every agent that has no key of its own above
# OPENROUTER_API_KEY=your_shared_openrouter_key

# OPTIONAL - Claude (Anthropic) key. NOT free: billed to your Anthropic account.
# Only used if you assign a "claude-..." model to an agent in Settings.
# ANTHROPIC_API_KEY=your_anthropic_key

# Optional: dashboard port (default 7860)
# MAAC_PORT=7860

# Optional safety limits (defaults shown). Can also be changed in the dashboard.
# MAAC_MAX_ROUNDS=4
# MAAC_MAX_REQUESTS=40
# MAAC_MAX_OUTPUT_TOKENS=60000
# MAAC_MAX_SECONDS=600
# MAAC_PER_CALL_TOKENS=900
# MAAC_MIN_INTERVAL_SECONDS=2
